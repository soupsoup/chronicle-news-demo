[Unit]
Description=Chronicle News editorial CMS demo (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
User=chronicle
Group=chronicle
WorkingDirectory=/var/www/chronicle/.releases/current
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=4420
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
MemoryHigh=200M
MemoryMax=300M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Next writes its image cache under .next/cache in the release.
ReadWritePaths=/var/www/chronicle/.releases

[Install]
WantedBy=multi-user.target
