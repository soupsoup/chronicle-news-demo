[Unit]
Description=Deploy the newest chronicle commit if main changed
After=network-online.target

[Service]
Type=oneshot
User=chronicle
Group=chronicle
WorkingDirectory=/var/www/chronicle
EnvironmentFile=-/etc/chronicle.env
Environment=NODE_OPTIONS=--max-old-space-size=1536
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/var/www/chronicle/deploy/vps/deploy.sh
Nice=10
CPUWeight=20
IOSchedulingClass=idle
TimeoutStartSec=20min
